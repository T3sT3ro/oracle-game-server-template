# Application Settings
APP_ENV=production
APP_URL=https://panel.{{ domain_name }}

# Proxy & Network Configuration
APP_BEHIND_PROXY=true

# Database Settings (MariaDB Service)
DB_CONNECTION=mysql
DB_HOST=calagopus-db
DB_PORT=3306
DB_DATABASE={{ vault_mysql_database }}
DB_USERNAME={{ vault_mysql_user }}
DB_PASSWORD={{ vault_mysql_password }}

MYSQL_DATABASE={{ vault_mysql_database }}
MYSQL_USER={{ vault_mysql_user }}
MYSQL_PASSWORD={{ vault_mysql_password }}
MYSQL_ROOT_PASSWORD={{ vault_mysql_root_password }}

# Calagopus Native Settings
DATABASE_MIGRATE=true