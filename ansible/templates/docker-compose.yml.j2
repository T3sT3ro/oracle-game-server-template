networks:
  calagopus-net:
    driver: bridge

services:
  caddy:
    image: caddy:2-alpine
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ data_mount_point }}/caddy/Caddyfile:/etc/caddy/Caddyfile
      - {{ data_mount_point }}/caddy/data:/data
    depends_on:
      calagopus-panel:
        condition: service_started
    networks:
      - calagopus-net

  calagopus-db:
    image: mariadb:10.11
    restart: always
    env_file: .env
    volumes:
      - {{ data_mount_point }}/calagopus/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 90s
    networks:
      - calagopus-net

  calagopus-panel:
    image: ghcr.io/calagopus/panel:latest
    restart: always
    env_file: .env
    volumes:
      - {{ data_mount_point }}/calagopus/var:/app/var
    depends_on:
      calagopus-db:
        condition: service_healthy
    networks:
      - calagopus-net

  dozzle:
    image: amir20/dozzle:latest
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      DOZZLE_NO_ANALYTICS: "true"
    networks:
      - calagopus-net