version: '3.8'

networks:
  pelican-net:
    driver: bridge

services:
  caddy:
    image: caddy:2-alpine
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ data_mount_point }}/caddy/Caddyfile:/etc/caddy/Caddyfile
      - {{ data_mount_point }}/caddy/data:/data
    networks:
      - pelican-net

  pelican-db:
    image: mariadb:10.11
    restart: always
    env_file: .env
    volumes:
      - {{ data_mount_point }}/pelican/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - pelican-net

  pelican-redis:
    image: redis:7-alpine
    restart: always
    networks:
      - pelican-net

  pelican-panel:
    image: ghcr.io/pelican/panel:latest
    restart: always
    env_file: .env
    environment:
      APP_BEHIND_PROXY: "true"
      BEHIND_PROXY: "true"
      LETSENCRYPT_EMAIL: "admin@{{ domain_name }}"
      DB_CONNECTION: "mysql"
    volumes:
      - {{ data_mount_point }}/pelican/var:/app/var
    depends_on:
      pelican-db:
        condition: service_healthy
      pelican-redis:
        condition: service_started
    networks:
      - pelican-net