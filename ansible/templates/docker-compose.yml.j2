version: '3.8'

networks:
  pelican-net:
    driver: bridge

services:
  caddy:
    image: caddy:2-alpine
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ data_mount_point }}/caddy/Caddyfile:/etc/caddy/Caddyfile
      - {{ data_mount_point }}/caddy/data:/data
    networks:
      - pelican-net

  pelican-db:
    image: mariadb:10.11
    restart: always
    env_file: .env
    volumes:
      - {{ data_mount_point }}/pelican/db:/var/lib/mysql
    networks:
      - pelican-net

  pelican-redis:
    image: redis:7-alpine
    restart: always
    networks:
      - pelican-net

  pelican-panel:
    image: ghcr.io/pelican-dev/panel:latest
    restart: always
    env_file: .env
    environment:
      APP_ENV: production
      DB_HOST: pelican-db
      REDIS_HOST: pelican-redis
    volumes:
      - {{ data_mount_point }}/pelican/var:/app/var
    depends_on:
      - pelican-db
      - pelican-redis
    networks:
      - pelican-net