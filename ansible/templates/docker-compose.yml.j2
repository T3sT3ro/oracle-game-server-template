networks:
  pelican-net:
    driver: bridge

volumes:
  pelican-code:

services:
  caddy:
    image: caddy:2-alpine
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ data_mount_point }}/caddy/Caddyfile:/etc/caddy/Caddyfile
      - {{ data_mount_point }}/caddy/data:/data
      - pelican-code:/app:ro
    networks:
      - pelican-net

  pelican-db:
    image: mariadb:10.11
    restart: always
    env_file: .env
    volumes:
      - {{ data_mount_point }}/pelican/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 90s
    networks:
      - pelican-net

  pelican-redis:
    image: redis:7-alpine
    restart: always
    networks:
      - pelican-net

  pelican-panel:
    image: ghcr.io/pelican/panel:latest
    restart: always
    env_file: .env
    environment:
      APP_BEHIND_PROXY: "true"
      BEHIND_PROXY: "true"
      LETSENCRYPT_EMAIL: "admin@{{ domain_name }}"
      DB_CONNECTION: "mysql"
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 9000 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    volumes:
      - pelican-code:/app
      - {{ data_mount_point }}/pelican/var:/app/var
    depends_on:
      pelican-db:
        condition: service_healthy
      pelican-redis:
        condition: service_started
    networks:
      - pelican-net

  dozzle:
    image: amir20/dozzle:latest
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      DOZZLE_NO_ANALYTICS: "true"
    networks:
      - pelican-net