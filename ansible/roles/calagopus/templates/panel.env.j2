# {{ ansible_managed }}
# Mounted at /.env inside the panel container. Reference: https://calagopus.com/docs/panel/environment
DATABASE_URL="postgresql://panel:{{ vault_postgres_password }}@db:5432/panel"
DATABASE_MIGRATE=true
REDIS_URL="redis://:{{ vault_valkey_password }}@cache:6379"

BIND=0.0.0.0
PORT=8000
APP_PRIMARY=true
APP_DEBUG=false
# AIO: browsers reach the bundled Wings through the panel under /wings-proxy/.
APP_ENABLE_WINGS_PROXY=true
APP_ENCRYPTION_KEY="{{ vault_calagopus_encryption_key }}"
# Decrypted secrets would otherwise linger in process memory for 30s.
APP_USE_DECRYPTION_CACHE=false
APP_USE_INTERNAL_CACHE=true
# Trust visitor IPs (X-Forwarded-For) only from Caddy's fixed address, not from apps on the web network.
APP_TRUSTED_PROXIES="{{ caddy_ip }}"
AIO_BASE_WINGS_CONFIGURATION=/wings-config.yml
