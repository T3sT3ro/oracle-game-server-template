# {{ ansible_managed }}
# Caddy: the only thing on this server that listens on ports 80 and 443.
name: web

services:
  caddy:
    image: "{{ images.caddy }}"
    restart: unless-stopped
    labels:
      # Changes when the Caddyfile changes, so `docker compose up` recreates Caddy.
      config-hash: "{{ lookup('template', 'Caddyfile.j2') | hash('sha256') | truncate(16, True, '') }}"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ data_mount_point }}/caddy/data:/data
      - {{ data_mount_point }}/caddy/config:/config
      - {{ data_mount_point }}/caddy/logs:/var/log/caddy
      - {{ web_sites_dir }}:/srv/sites:ro
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    cap_add: [NET_BIND_SERVICE]
    security_opt: ["no-new-privileges:true"]
    networks:
      web:
        ipv4_address: {{ caddy_ip }}

networks:
  web:
    external: true
    name: {{ web_network }}
