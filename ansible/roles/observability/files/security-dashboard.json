{
  "title": "Security overview",
  "uid": "gameserver-security",
  "tags": [
    "security",
    "gameserver"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Panel login failures (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" | uri=~\"/api/auth/login.*\" | status=~\"4..\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP 5xx (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" | status=~\"5..\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Distinct client IPs (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (client_ip) (count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SSH auth failures (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"journal\", syslog_identifier=~\"sshd.*\"} |~ \"(?i)(failed password|invalid user|authentication failure|maximum authentication)\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Panel login failures",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (client_ip) (count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" | uri=~\"/api/auth/login.*\" | status=~\"4..\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{client_ip}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top client IPs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (client_ip) (count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top 4xx/5xx URIs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (uri, status) (count_over_time({job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" | status=~\"[45]..\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container error lines",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({job=\"docker\"} |~ \"(?i)\\\\b(error|panic|fatal)\\\\b\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Recent 4xx/5xx requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"caddy\"} | json status=\"status\", uri=\"request.uri\", client_ip=\"request.client_ip\", host=\"request.host\" | status=~\"[45]..\" | line_format \"{{.status}} {{.client_ip}} {{.uri}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "SSH and Tailscale events",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"journal\", syslog_identifier=~\"sshd.*|tailscaled\"} |~ \"(?i)(accepted|failed|invalid|disconnect|login)\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
